{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "npm run check:sources && npm run check:design && npm run check:chips && next build",
    "start": "next start",
    "check:voice": "node scripts/check-voice.mjs",
    "build:context": "node --experimental-strip-types scripts/build-context.mjs",
    "check:context": "node --experimental-strip-types scripts/build-context.mjs --check",
    "check:sources": "npm run check:voice && npm run check:context && npm run check:docs && npm run check:render && npm run check:intent && npm run check:alt && npm run check:numbers && npm run check:api",
    "check:design": "node scripts/check-design.mjs && node scripts/check-fallback.mjs",
    "check:chips": "node --experimental-strip-types scripts/check-chips.mjs",
    "clean": "node scripts/clean.mjs",
    "check:docs": "node --experimental-strip-types scripts/check-docs.mjs",
    "check:render": "node --import ./scripts/ts-extensionless.mjs scripts/check-render.mjs",
    "check:intent": "node --import ./scripts/ts-extensionless.mjs scripts/check-intent.mjs",
    "check:alt": "node --import ./scripts/ts-extensionless.mjs scripts/check-alt.mjs",
    "check:numbers": "node scripts/check-numbers.mjs",
    "check:api": "node --import ./scripts/ts-extensionless.mjs scripts/check-api.mjs",
    "check:paint": "node scripts/check-paint.mjs",
    "build:resume": "node --import ./scripts/ts-extensionless.mjs scripts/build-resume.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/react": "^3.0.0",
    "ai": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    }
  }
}
